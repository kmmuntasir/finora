# Copy to .env next to docker-compose.yml and fill in. Keep it out of git.
FINORA_WEB_PORT=8080
FINORA_API_PORT=8081
# The same Jellyfin address browsers use.
FINORA_JELLYFIN_URL=http://<public-ip>:<port>
# Jellyfin dashboard → Administration → API Keys. Leave empty to enter it in Admin → Finora.
FINORA_JELLYFIN_API_KEY=
# Where Finora Web is served from, as the browser sees it.
FINORA_ALLOWED_ORIGINS=http://<public-ip>:8080
# Optional, for Google sign-in (must be HTTPS):
FINORA_PUBLIC_URL=
FINORA_GOOGLE_CLIENT_ID=
FINORA_GOOGLE_CLIENT_SECRET=
